# DeepSeek / DSH runtime
DEEPSEEK_API_KEY=
# dsh talks to DeepSeek through the Anthropic-compatible Messages API, so the
# base URL MUST end with /anthropic - otherwise dsh posts to /v1/messages,
# which returns HTTP 404 and the model never emits any text.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash
DSH_COMMAND=dsh
DSH_PROFILE=sdk
DSH_MODEL=deepseek-flash

# Optional runtime overrides
DSH_PROVIDER=deepseek-official
DSH_HOME=/app/work/dsh-home
